# Application
NODE_ENV=development
PORT=8080
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/crypto_intel?schema=public

# Redis Cache & PubSub
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_ACCESS_SECRET=super_secret_jwt_access_key_change_in_production_32bytes
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production_32bytes
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Blockchain RPC Endpoints & API Keys
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
BSC_RPC_URL=https://bsc-dataseed.binance.org
BITCOIN_API_URL=https://mempool.space/api
TRONGRID_API_URL=https://api.trongrid.io
TRONGRID_API_KEY=
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws

